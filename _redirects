# This file tells Netlify how to handle old or moved links so they never
# just "break." You don't need to edit this by hand — if an article is ever
# renamed, add a line here in the form:
#   /old-address.html   /new-address.html   301
#
# Example (kept here as a template, not an active redirect):
# /old-slug-example.html   /new-slug-example.html   301

# Private chat tool: keep this above the catch-all article rules below so
# /chat resolves to the tool page instead of being rewritten to an article.
/chat   /tools/chat.html   200

# Published articles live in the /articles folder in this repository, but
# should be reachable at a clean top-level address, e.g.
# https://sermons.wordandhope.com/some-article.html instead of
# https://sermons.wordandhope.com/articles/some-article.html. This rule
# does that rewrite for every article automatically — you never need to
# add a line here for a new article.
/*.html   /articles/:splat.html   200

# Article links are also reachable without the .html extension, e.g.
# https://sermons.wordandhope.com/some-article instead of
# https://sermons.wordandhope.com/some-article.html. This rule rewrites
# any extensionless top-level path to its article file automatically —
# you never need to add a line here for a new article.
/*   /articles/:splat.html   200
